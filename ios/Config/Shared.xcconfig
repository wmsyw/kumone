// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = KumoneIOS
PRODUCT_DISPLAY_NAME = Kumone
PRODUCT_BUNDLE_IDENTIFIER = im.missuo.Kumone
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM = 
CODE_SIGN_STYLE = Automatic

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 18.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// Without a launch-screen declaration iOS letterboxes the app
// in legacy compatibility mode (black bars top and bottom).
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
INFOPLIST_KEY_UIBackgroundModes = audio
INFOPLIST_KEY_NSAppTransportSecurity_NSAllowsArbitraryLoads = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/KumoneIOS.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/KumoneIOS.entitlements
